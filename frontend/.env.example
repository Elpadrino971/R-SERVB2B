# Backend API URL (optionnel si Supabase utilisé)
REACT_APP_BACKEND_URL=http://localhost:8000

# Supabase (backend B2B - auth + base de données)
REACT_APP_SUPABASE_URL=https://votre-projet.supabase.co
REACT_APP_SUPABASE_ANON_KEY=votre_anon_key

# Upload Provider (backend | cloudflare | aws | supabase)
REACT_APP_UPLOAD_PROVIDER=backend

# Environment
NODE_ENV=development
