# Backend API URL
REACT_APP_BACKEND_URL=http://localhost:8000

# Stripe Public Key (for frontend payment integration)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Upload Provider (backend | cloudflare | aws | supabase)
REACT_APP_UPLOAD_PROVIDER=backend

# Environment
NODE_ENV=development
